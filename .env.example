# ==================== AI API配置 ====================

# OpenAI配置
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1  # 可自定义API端点
OPENAI_MODEL=gpt-4-turbo-preview  # 可选: gpt-4, gpt-4-turbo, gpt-3.5-turbo
OPENAI_TIMEOUT=60  # API超时时间(秒)
OPENAI_MAX_TOKENS=4000  # 最大生成token数
OPENAI_API_MODE=auto  # 官方GPT-5/o系列自动用Responses；兼容网关继续用Chat
# OPENAI_REASONING_EFFORT=medium
# OPENAI_REASONING_SUMMARY=auto
# OPENAI_VERBOSITY=medium

# Anthropic (Claude)配置
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_MAX_TOKENS=64000  # thinking与长代码共享输出额度
ANTHROPIC_TIMEOUT=600
ANTHROPIC_THINKING_DISPLAY=summarized  # Opus 5流式展示思考摘要；可设omitted
# Opus 5不接受temperature；只有旧Claude模型才配置下一项
# ANTHROPIC_TEMPERATURE=0.1
# AWS Bedrock转发层需要时启用；程序也会在缺字段400后自动补齐并重试
# ANTHROPIC_BEDROCK_VERSION=bedrock-2023-05-31

# DeepSeek配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/
DEEPSEEK_MODEL=deepseek-v4-pro  # 推理模型；可选 deepseek-v4-flash
DEEPSEEK_TIMEOUT=300  # 推理模型思考时间长，超时给足
DEEPSEEK_MAX_TOKENS=102400

# 本地AI配置（如Ollama）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2  # 或 codellama, mistral 等
OLLAMA_TIMEOUT=120

# AI提供者选择
# 支持的提供者: openai, claude, deepseek, ollama, local
AI_PROVIDER=openai
AI_FALLBACK_PROVIDER=local  # 主提供者失败时的备用提供者

# AI请求限制
AI_MAX_RETRIES=3
AI_RETRY_DELAY=2  # 重试延迟(秒)
AI_RATE_LIMIT=10  # 每分钟最大请求数

# 数据库配置
DATABASE_URL=sqlite:///./data.db
DATABASE_CONNECT_TIMEOUT=5  # 数据库网络连接超时（秒），避免启动时长时间卡住
DATABASE_POOL_TIMEOUT=10  # 连接池耗尽时等待上限（秒）

# Redis配置（用于任务队列）
# 外部 Redis：Docker 内不要填 localhost；请改为 Redis 服务器的内网 IP 或域名。
# 有密码示例：redis://:your_password@192.168.1.100:6379/0
REDIS_URL=redis://192.168.1.100:6379/0

# 应用配置
DEBUG=True
SECRET_KEY=your_secret_key_here
ALLOWED_HOSTS=localhost,127.0.0.1

# 文件存储配置
MAX_UPLOAD_SIZE=104857600  # 100MB
ALLOWED_FILE_TYPES=.xlsx,.xls,.txt,.md,.pdf,.doc,.docx

# 训练配置
MAX_TRAINING_ITERATIONS=2
MIN_MATCH_SCORE=0.7

# 训练成功阈值配置
# 训练成功的最低分数阈值（0.0-1.0），达到此分数认为训练成功
TRAINING_SUCCESS_THRESHOLD=0.95
# 完美匹配阈值（0.0-1.0），达到此分数提前结束训练
TRAINING_PERFECT_THRESHOLD=1.0

# 沙箱配置（AI 脚本在独立子进程执行，超时/超内存强杀，防主进程内存失控 → VM 假死）
CODE_SANDBOX_TIMEOUT=360       # 脚本执行超时（秒）
CODE_SANDBOX_MAX_MEMORY=0   # 0=按可用内存分配预算，受系统保留量及任务最大预算约束

# 子进程防护（subprocess_runner：解析/公式计算/整合回填等重活在独立子进程执行，
# 超时或超内存直接强杀，杜绝 VM 内存耗尽 → swap 风暴 → 宿主 C 盘 IO 100%）
SUBPROCESS_PARSE_TIMEOUT=300      # 解析超时（秒）
SUBPROCESS_CALC_TIMEOUT=120       # 公式计算超时（秒）
SUBPROCESS_WRITE_TIMEOUT=600      # 整合回填/写操作超时（秒）
SUBPROCESS_MAX_MEMORY_MB=0   # 0=自动预算；正数仅作为额外硬上限
SUBPROCESS_CONCURRENCY=1    # 默认串行，减少内存叠加与磁盘争用
APP_RELOAD=false                  # 发布环境禁止热重载；本地开发确需热更新时才设true
SUBPROCESS_POOL_SIZE=0     # 0=关闭常驻 Aspose 池，任务完成后回收进程内存
EXCEL_WORK_CONCURRENCY=1   # 智算、智训和上传解析共享执行槽
TRAINING_WORK_CONCURRENCY=1
TRAINING_PARSE_CONCURRENCY=1
EXCEL_QUEUE_NOTICE_INTERVAL=15    # 排队时每隔多少秒向 SSE 推送可见状态
EXCEL_QUEUE_MAX_WAIT=1800         # Excel 并发队列最长等待时间（秒）
SUBPROCESS_QUEUE_TIMEOUT=600      # 排队等待上限（秒）：大文件复杂计算本身可达数分钟，排队需等得起
COMPUTE_PROC_TIMEOUT=3600         # 智算子进程超时（秒），超时强杀
COMPUTE_PROC_MAX_MEMORY_MB=0  # 自动预算，不再固定 2GB；不会超出可用内存预算
COMPUTE_PRECHECK_TIMEOUT=600      # 智算上传预处理/预检查超时（秒）
COMPUTE_PRECHECK_MAX_MEMORY_MB=0
TRAINING_UPLOAD_TIMEOUT=600       # 智训上传解密/转换/规范化超时（秒）
TRAINING_UPLOAD_MAX_MEMORY_MB=0
UPLOAD_CHECK_MAX_MEMORY_MB=0

# 基础数据上传：后台队列固定单并发，每个文件使用全新子进程
ASSET_UPLOAD_PARSE_TIMEOUT=900    # 单文件预处理+解析超时（秒）
ASSET_UPLOAD_MAX_MEMORY_MB=0
UPLOAD_SPOOL_MEMORY_BYTES=65536   # multipart 单文件内存缓冲，超过后由 Starlette 自动转临时盘

# Docker 部署（多环境同机：dev/uat 各自目录一份 .env，以下值务必各不相同）
# IMAGE_NAME=datamerge-dev
# APP_CONTAINER_NAME=datamerge-dev-app
APP_PORT=18000
# 容器资源上限（配合 Ubuntu 32G 双环境方案：2 容器 × 12g + 系统 3g + 余量 = 32g）
# APP_MEM_LIMIT=12g
# APP_MEM_RESERVATION=2g
# APP_CPUS=4

# 计算结果输出：是否在"带公式版"外再生成"纯值版"（公式算成值、仅目标sheet）。默认true，设false关闭
COMPUTE_OUTPUT_VALUES_COPY=true

# 代码生成模式配置
USE_MODULAR_GENERATION=true     # auto/true/false：模块化生成
USE_FORMULA_MODE=true           # true=公式模式（基础列填数据，计算列用Excel公式）
FORMULA_MAX_ROUNDS=1            # 公式模式续写轮数（1=一次性生成）
FORMULA_VERIFY_CODE=true        # 生成后AI自审修正

# Excel解析配置
EXCEL_MAX_COLUMNS=150           # 最大列数限制（防超大文件耗费资源）
EXCEL_READ_ACTIVE_SHEET_ONLY=true  # 只读激活Sheet
EXCEL_SKIP_HIDDEN_SHEETS=true   # 跳过隐藏Sheet
HEADER_MATCH_THRESHOLD=0.85     # 表头匹配相似度阈值

# 规则整理配置
RULE_ORGANIZE_MAX_DOC_CHARS=90000  # 长文档分段处理阈值（全文分段读取，不截掉尾部）

# 测试环境迁移（系统管理→测试迁移：从测试环境拉取已训练脚本迁入本环境）。地址+超管账号密码
TEST_ENV_BASE_URL=
TEST_ENV_USERNAME=
TEST_ENV_PASSWORD=
# 智训/智算上传文件时是否自动按 banner 拆分多区域 sheet（false=保持原样，默认）。
# 不影响"智能小工具 → Sheet拆分"手动功能。
ENABLE_BANNER_SPLIT=false

# 数据库（生产建议 PostgreSQL）
# PG_HOST=192.168.10.139
# PG_PORT=5432
# PG_USER=your_user
# PG_PASSWORD=your_password
# PG_DATABASE=datamerge
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/datamerge
EXCEL_PARSE_WORKERS=1      # 单个任务内的文件解析也默认串行
EXCEL_QUEUE_MAX_PENDING=32  # 等待执行槽的最大任务数
EXCEL_MEMORY_RESERVE_MB=256  # 保留量取此值、256MB、有效总内存15%中的最大值
EXCEL_TASK_MEMORY_CEILING_MB=8192  # 自动预算的最高值，实际还受可用内存约束
SUBPROCESS_KILL_GRACE_SECONDS=5  # 强杀后的最长退出等待，失败则停止派发
COMPUTE_STRICT_FORMULA_ERRORS=false  # 与智训一致：已完成计算的公式错误作为告警，保留结果下载；true 可严格拦截
COMPARISON_NUMERIC_TOLERANCE=0.000000001  # 智训数值对比绝对误差；一分钱差异仍判为不一致
